{
  "name": "cents-app",
  "version": "0.6.0",
  "description": "Android-first Expo expense tracker backed by Supabase",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamvritSrinath/cents-app.git"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchman=false",
    "test:ci": "jest --ci --watchman=false --coverage --coverageReporters=text-summary --coverageReporters=text --forceExit",
    "test:e2e:ci": "node scripts/bundle-e2e-smoke.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "generate-ci-docs": "node scripts/generate-ci-docs.mjs",
    "verify-ci-docs": "node scripts/generate-ci-docs.mjs && git diff --exit-code docs/generated/ci-pipeline.md",
    "docs:api": "typedoc",
    "docs:api:html": "typedoc --options typedoc.site.json",
    "docs:dev": "node scripts/ensure-api-html.mjs && vitepress dev docs",
    "docs:build": "npm run docs:api:html && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify-api-docs": "node scripts/verify-api-docs.mjs"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.12",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.562.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.7.4",
    "react-test-renderer": "^19.1.0",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "~5.9.2",
    "vitepress": "^1.6.4",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  },
  "private": true
}
