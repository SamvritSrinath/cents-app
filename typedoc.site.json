{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "expand",
  "entryPoints": ["lib/**/*.ts", "hooks/**/*.ts", "types/database.ts"],
  "exclude": ["**/*.test.ts", "**/__mocks__/**", "**/node_modules/**"],
  "out": "docs/.vitepress/public/api",
  "readme": "none",
  "hideGenerator": true,
  "disableSources": true,
  "tsconfig": "./tsconfig.json"
}
