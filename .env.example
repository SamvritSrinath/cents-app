# Environment variables for Cents mobile app
# Copy this file to .env.local and fill in your values
#
# EAS / standalone APK: .env.local is not uploaded (gitignored). In Expo
# (expo.dev) open Project → Environment variables and add the same
# EXPO_PUBLIC_* names for the "preview" (or "production") environment, then rebuild.

# Supabase Configuration
# Get these from your Supabase project: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key-here

# Receipt OCR (FastAPI PaddleOCR service — see expensely/ocr-service and docs/07-ocr-service.md)
# Base URL only, no trailing slash. The app POSTs multipart image to {URL}/ocr
#
# Local dev:
#   - iOS Simulator: http://127.0.0.1:8000 or http://localhost:8000
#   - Android Emulator: http://10.0.2.2:8000 (host machine loopback)
# Physical device / production: use HTTPS (e.g. deployed ocr-service). Plain HTTP on
# Android may require usesCleartextTraffic in app.json for dev only.
EXPO_PUBLIC_OCR_API_URL=http://127.0.0.1:8000
